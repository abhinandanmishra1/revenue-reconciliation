# Root env for `docker compose up`. Copy to .env; placeholders only, never commit real values.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional: without these, explanations use the deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
