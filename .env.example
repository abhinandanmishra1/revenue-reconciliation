# Root env for `docker compose up`. Copy to .env and fill in; never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional: without these, "Explain with AI" uses the deterministic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=

# Local database (only reachable inside the compose network).
POSTGRES_USER=revrec
POSTGRES_PASSWORD=revrec
POSTGRES_DB=revrec

# API settings. APP_ORIGINS must match the URL you open in the browser.
COOKIE_SECURE=false
APP_ORIGINS=http://localhost:3000
TRUSTED_PROXY_HOPS=0

# Host ports. If you change WEB_PORT, change APP_ORIGINS to match.
WEB_PORT=3000
API_PORT=8000
